{
  "name": "rally-timing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:server": "node --conditions=react-server --import tsx scripts/db-server.mts",
    "db:migrate": "node --conditions=react-server --import tsx scripts/db-migrate.mts",
    "db:generate": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs generate",
    "db:seed": "node --conditions=react-server --import tsx scripts/db-seed.mts",
    "device:authorize": "node --conditions=react-server --import tsx scripts/device-authorize.mts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@next/env": "16.4.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "download"
    }
  }
}
